generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                   String                @id @default(uuid())
  username             String
  email                String                @unique
  role                 Role                  @default(USER)
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  googleId             String                @unique
  isEmailVerified      Boolean               @default(true)
  profilePicture       String?
  comments             Comment[]
  likes                Like[]
  newsletterSubscriber NewsletterSubscriber?
  opinions             UnpopularOpinion[]
}

model Quotes {
  id        String   @id @default(uuid())
  quote     String
  author    String
  rank      Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id                   String      @id @default(uuid())
  title                String
  content              String
  genres               String[]
  year                 Int
  createdAt            DateTime    @default(now())
  updatedAt            DateTime    @updatedAt
  adminId              Int         @default(1)
  relatedPostIds       String[]
  posterImageUrl       String?
  reviewPosterImageUrl String?
  directedBy           String
  streamingAt          String
  ratingCategories     Json
  viewCount            Int         @default(0)
  language             String      @default("English")
  comments             Comment[]
  likes                Like[]
  images               PostImage[]
}

model byGenres {
  id             String   @id @default(uuid())
  genre          String[]
  directedBy     String
  year           Int
  posterImageUrl String
  title          String
  synopsis       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model IndieMovies {
  id             String   @id @default(uuid())
  genres         String[]
  title          String
  year           Int
  posterImageUrl String
  directedBy     String
  streamingAt    String
  synopsis       String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Article {
  id                String         @id @default(uuid())
  title             String
  shortDescription  String
  slug              String
  author            String
  mainImageUrl      String
  published         Boolean        @default(true)
  publishedAt       DateTime?
  viewCount         Int            @default(0)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  mainImagePublicId String?
  images            ArticleImage[]
  comments          Comment[]
  blocks            ContentBlock[]
  likes             Like[]
}

model ContentBlock {
  id        String    @id @default(uuid())
  articleId String
  type      BlockType
  content   Json
  order     Int
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  publicId  String?
  article   Article   @relation(fields: [articleId], references: [id], onDelete: Cascade)

  @@index([articleId, order])
}

model TopPicks {
  id             String   @id @default(uuid())
  genre          String
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  posterImageUrl String
  title          String
  year           Int
}

model PostImage {
  id        String   @id @default(uuid())
  imageUrl  String
  postId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  post      Post     @relation(fields: [postId], references: [id], onDelete: Cascade)
}

model ArticleImage {
  id        String   @id @default(uuid())
  imageUrl  String
  articleId String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  article   Article  @relation(fields: [articleId], references: [id], onDelete: Cascade)
}

model Comment {
  id              String            @id @default(uuid())
  content         String
  userId          String
  postId          String?
  opinionId       String?
  parentCommentId String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  articleId       String?
  article         Article?          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  opinion         UnpopularOpinion? @relation(fields: [opinionId], references: [id])
  parentComment   Comment?          @relation("CommentToComment", fields: [parentCommentId], references: [id])
  replies         Comment[]         @relation("CommentToComment")
  post            Post?             @relation(fields: [postId], references: [id], onDelete: Cascade)
  user            User              @relation(fields: [userId], references: [id])
}

model Like {
  id        String            @id @default(uuid())
  userId    String
  postId    String?
  opinionId String?
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  articleId String?
  article   Article?          @relation(fields: [articleId], references: [id], onDelete: Cascade)
  opinion   UnpopularOpinion? @relation(fields: [opinionId], references: [id])
  post      Post?             @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User              @relation(fields: [userId], references: [id])

  @@unique([userId, postId])
}

model UnpopularOpinion {
  id        String    @id @default(uuid())
  userId    String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  content   String
  genres    String[]
  comments  Comment[]
  likes     Like[]
  user      User      @relation(fields: [userId], references: [id])
}

model TrendingMovie {
  id              Int      @id @default(autoincrement())
  tmdbId          Int      @map("tmdb_id")
  title           String
  posterPath      String?  @map("poster_path")
  backdropPath    String?  @map("backdrop_path")
  overview        String?
  releaseDate     DateTime @map("release_date") @db.Date
  voteAverage     Decimal  @map("vote_average") @db.Decimal(3, 1)
  voteCount       Int      @map("vote_count")
  popularityScore Decimal  @map("popularity_score") @db.Decimal(10, 2)
  trendingRank    Int      @map("trending_rank")
  genreIds        String   @map("genre_ids")
  lastUpdated     DateTime @default(now()) @map("last_updated")
  createdAt       DateTime @default(now()) @map("created_at")

  @@index([tmdbId])
  @@index([trendingRank])
  @@index([lastUpdated])
  @@map("trending_movies")
}

model TrendingNews {
  id            Int      @id @default(autoincrement())
  title         String
  description   String
  content       String?
  url           String   @unique
  sourceName    String   @map("source_name")
  author        String?
  publishedAt   DateTime @map("published_at")
  imageUrl      String?  @map("image_url")
  category      String
  trendingScore Int?     @map("trending_score")
  lastUpdated   DateTime @default(now()) @map("last_updated")
  createdAt     DateTime @default(now()) @map("created_at")

  @@index([publishedAt])
  @@index([lastUpdated])
  @@index([category])
  @@map("trending_news")
}

model AITrendingContent {
  id              Int           @id @default(autoincrement())
  title           String
  content         String
  contentType     ContentType   @map("content_type")
  promptUsed      String?       @map("prompt_used")
  status          ContentStatus @default(active)
  viewCount       Int           @default(0) @map("view_count")
  engagementScore Decimal?      @map("engagement_score") @db.Decimal(5, 2)
  expiresAt       DateTime?     @map("expires_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")

  @@index([contentType])
  @@index([status])
  @@index([createdAt])
  @@index([expiresAt])
  @@map("ai_trending_content")
}

model ContentRefreshLog {
  id                    Int           @id @default(autoincrement())
  sectionType           SectionType   @map("section_type")
  lastRefreshAttempt    DateTime      @default(now()) @map("last_refresh_attempt")
  lastSuccessfulRefresh DateTime?     @map("last_successful_refresh")
  status                RefreshStatus
  errorMessage          String?       @map("error_message")
  recordsUpdated        Int?          @map("records_updated")

  @@index([sectionType])
  @@index([lastSuccessfulRefresh])
  @@index([status])
  @@map("content_refresh_log")
}

model NewsletterPlan {
  id              String                   @id @default(uuid())
  name            String
  description     String?
  type            NewsletterType
  billingInterval BillingInterval
  amount          Decimal                  @db.Decimal(10, 2)
  currency        String                   @default("inr")
  isActive        Boolean                  @default(true)
  stripePriceId   String?
  razorpayPlanId  String?
  createdAt       DateTime                 @default(now())
  updatedAt       DateTime                 @updatedAt
  campaigns       NewsletterCampaign[]
  subscriptions   NewsletterSubscription[]
}

model NewsletterSubscriber {
  id               String                   @id @default(uuid())
  email            String                   @unique
  name             String?
  userId           String?                  @unique
  status           SubscriberStatus         @default(PENDING)
  country          String?
  provider         PaymentProvider?
  unsubscribeToken String                   @unique @default(uuid())
  unsubscribedAt   DateTime?
  confirmToken     String?
  confirmedAt      DateTime?
  createdAt        DateTime                 @default(now())
  updatedAt        DateTime                 @updatedAt
  emailLogs        NewsletterEmailLog[]
  user             User?                    @relation(fields: [userId], references: [id])
  subscriptions    NewsletterSubscription[]
}

model NewsletterSubscription {
  id                        String               @id @default(uuid())
  subscriberId              String
  planId                    String
  provider                  PaymentProvider
  status                    PaymentStatus        @default(ACTIVE)
  stripeCustomerId          String?
  stripeSubscriptionId      String?              @unique
  stripePaymentMethodId     String?
  razorpayCustomerId        String?
  razorpaySubscriptionId    String?              @unique
  razorpayMandateId         String?
  razorpayPaymentMethodType String?
  currentPeriodStart        DateTime
  currentPeriodEnd          DateTime
  cancelAtPeriodEnd         Boolean              @default(false)
  canceledAt                DateTime?
  retryCount                Int                  @default(0)
  lastPaymentError          String?
  createdAt                 DateTime             @default(now())
  updatedAt                 DateTime             @updatedAt
  payments                  NewsletterPayment[]
  plan                      NewsletterPlan       @relation(fields: [planId], references: [id])
  subscriber                NewsletterSubscriber @relation(fields: [subscriberId], references: [id])

  @@unique([subscriberId, planId])
}

model NewsletterPayment {
  id                    String                 @id @default(uuid())
  subscriptionId        String
  provider              PaymentProvider
  status                InvoiceStatus
  amount                Decimal                @db.Decimal(10, 2)
  currency              String
  stripeInvoiceId       String?                @unique
  stripePaymentIntentId String?
  razorpayPaymentId     String?                @unique
  razorpayInvoiceId     String?
  paidAt                DateTime?
  failureReason         String?
  createdAt             DateTime               @default(now())
  subscription          NewsletterSubscription @relation(fields: [subscriptionId], references: [id])
}

model NewsletterCampaign {
  id              String               @id @default(uuid())
  planId          String
  subject         String
  previewText     String?
  content         Json
  status          CampaignStatus       @default(DRAFT)
  scheduledAt     DateTime?
  sentAt          DateTime?
  totalRecipients Int                  @default(0)
  totalSent       Int                  @default(0)
  totalOpened     Int                  @default(0)
  totalClicked    Int                  @default(0)
  totalBounced    Int                  @default(0)
  createdAt       DateTime             @default(now())
  updatedAt       DateTime             @updatedAt
  plan            NewsletterPlan       @relation(fields: [planId], references: [id])
  emailLogs       NewsletterEmailLog[]
}

model NewsletterEmailLog {
  id            String               @id @default(uuid())
  subscriberId  String
  campaignId    String
  sesMessageId  String?              @unique
  status        EmailLogStatus       @default(QUEUED)
  sentAt        DateTime?
  openedAt      DateTime?
  clickedAt     DateTime?
  bouncedAt     DateTime?
  complainedAt  DateTime?
  bounceType    String?
  bounceSubType String?
  createdAt     DateTime             @default(now())
  campaign      NewsletterCampaign   @relation(fields: [campaignId], references: [id])
  subscriber    NewsletterSubscriber @relation(fields: [subscriberId], references: [id])

  @@index([subscriberId])
  @@index([campaignId])
  @@index([sesMessageId])
  @@index([status])
}

enum Role {
  USER
  ADMIN
}

enum BlockType {
  PARAGRAPH
  HEADING
  IMAGE
  LIST
  QUOTE
  DIVIDER
}

enum ContentType {
  discussion
  recommendation
  analysis
  matchup
}

enum ContentStatus {
  active
  archived
  draft
}

enum SectionType {
  movies
  news
  ai
}

enum RefreshStatus {
  success
  failed
  in_progress
}

enum NewsletterType {
  BOLLYWOOD
  HOLLYWOOD
}

enum PaymentProvider {
  STRIPE
  RAZORPAY
}

enum SubscriberStatus {
  PENDING
  ACTIVE
  PAST_DUE
  CANCELED
  UNSUBSCRIBED
}

enum BillingInterval {
  MONTHLY
  YEARLY
}

enum PaymentStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  TRIALING
}

enum InvoiceStatus {
  PAID
  OPEN
  FAILED
  VOID
}

enum CampaignStatus {
  DRAFT
  SCHEDULED
  SENDING
  SENT
}

enum EmailLogStatus {
  QUEUED
  SENT
  OPENED
  CLICKED
  BOUNCED
  COMPLAINED
  FAILED
}
